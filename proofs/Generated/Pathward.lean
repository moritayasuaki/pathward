/-- [pathward::tls::renewal_due]:
    Source: 'src/tls.rs', lines 50:0-57:1
    Visibility: public -/
def tls.renewal_due
  (not_before : Std.U64) (not_after : Std.U64) (now : Std.U64) :
  RustM Bool
  := do
  if now < not_before
  then ok true
  else
    if now >= not_after
    then ok true
    else
      let lifetime ← not_after - not_before
      let remaining ← not_after - now
      let i ← lifetime / 3#u64
      ok (remaining <= i)

