              if pin.links = 1#u64
              then
                if opened.links = 1#u64
                then
                  if pin.size <= 1048576#u64
                  then
                    if opened.size = pin.size
                    then
                      if pin.device = opened.device
                      then ok (pin.inode = opened.inode)
                      else ok false
                    else ok false
                  else ok false
                else ok false
              else ok false
            else ok false
          else ok false
        else ok false
      else ok false
    else ok false
  else ok false

