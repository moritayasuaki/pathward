  (publications : Slice rules.Publication) :
  RustM (Option serving.Grant)
  := do
  let s ← lift (Array.to_slice (Array.make 3#usize [ 71#u8, 69#u8, 84#u8 ]))
  let get ← same_path method s
  if get
  then
    let b ← same_path host configured_host
